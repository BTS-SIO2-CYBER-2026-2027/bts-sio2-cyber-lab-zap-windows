# Cible locale du laboratoire. Les scripts ZAP refusent les cibles Internet.
APP_URL=http://127.0.0.1:3000
APP_PORT=3000

# Audit automatique : 1 = baseline puis full scan dès que l'application générée répond.
AUTO_BASELINE_SCAN=1
AUTO_ACTIVE_SCAN=1

# Délai sans modification dans app/ avant de considérer la génération IA comme stabilisée.
AUTO_AUDIT_DEBOUNCE_SECONDS=12
